name: Daily Word of the Day

on:
  schedule:
    - cron: "0 8 * * *"   # 08:00 UTC ≈ 1:00am PT during DST
  workflow_dispatch: {}
  push:
    branches: [ "main" ]

permissions:
  contents: write
  pages: write
  id-token: write

jobs:
  wod:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Install deps
        run: npm ci

      - name: Generate WOD JSON
        env:
          OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}
        run: npm run wod

      - name: Commit WOD
        uses: stefanzweifel/git-auto-commit-action@v5
        with:
          commit_message: "chore(wod): update word of the day [skip ci]"
          branch: ${{ github.ref_name }}
          file_pattern: public/wod.json

      # (Optional but recommended) sanity check today's date is present
      - name: Assert wod.json contains today
        run: |
          date=$(date -u +"%Y-%m-%d")
          echo "Expecting date: $date"
          grep -q "$date" public/wod.json || (echo "ERROR: public/wod.json missing $date" && exit 1)

      # Upload the *fresh* site as the Pages artifact
      - name: Upload artifact (static site in /public)
        uses: actions/upload-pages-artifact@v3
        with:
          path: ./public

  deploy:
    needs: wod
    runs-on: ubuntu-latest
    concurrency:
      group: "pages"
      cancel-in-progress: true
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
